#while loops

#print numbers from 1 to 10
i=1
while i<=100:
    print(i)
    i+=1
print ("loop ended")

#print numbers from 100 to 1
i=100
while i>=1:
    print(i)
    i-=1
print("loop ended")

#print multiplication table of n
n=int(input("Enter a number:"))
i=1
while i<=10:
    print(n*i)
    i+=1

#printing squares of the first 10 numbers
num=[1,4,9,16,25,36,49,64,81,100] #length of list from lists file
i=0
while i<len(num):
    print(num[i])
    i+=1



#for loops

#odd and even numbers in given range
n=int(input("Enter number:"))
print("the even numbers:")
for i in range(2,n+1,2):
    print(i, end="")
print(" \n the odd numbers:")
for i in range(1,n+1,2):
    print(i, end="")

#sum of n natural numbers
n = int(input("enter a number: "))
total_sum = 0 
for i in range(1, n + 1):
    total_sum += i
print("the sum of natural numbers =", total_sum)

